# FEATHERLESS_API_KEY: Required for real Featherless AI requests (Server-side only).
# Configure this in the AI Studio Secrets panel. Never expose in client code.
FEATHERLESS_API_KEY=""

# FEATHERLESS_MODEL: Required default model ID on Featherless AI (e.g. DeepSeek, Kimi, or GLM model ID).
FEATHERLESS_MODEL=""

# Optional: Configure specific Featherless model IDs for switching between DeepSeek, Kimi, and GLM
FEATHERLESS_MODEL_DEEPSEEK=""
FEATHERLESS_MODEL_KIMI=""
FEATHERLESS_MODEL_GLM=""

# Optional: Featherless API Base URL (defaults to https://api.featherless.ai/v1)
FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
